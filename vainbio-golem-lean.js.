// vainbio-golem-lean.js
// Simplified. Express only. No external crypto. Tested.

const express = require('express');
const fs = require('fs');
const app = express();

const redirects = {
  '6': 'https://example.com/page1',
  'cure': 'https://example.com/page2',
  'xrt': 'https://example.com/page3',
  'xxx': 'https://example.com/page4',
  'nigger': 'https://example.com/page5',
  'xvs': 'https://example.com/page6'
};

const LOG_FILE = 'vainbio-logs.json';

function initializeLogs() {
  if (!fs.existsSync(LOG_FILE)) {
    fs.writeFileSync(LOG_FILE, JSON.stringify({
      targets: [],
      total_captures: 0,
      created: new Date().toISOString()
    }, null, 2));
  }
}

app.get('/:slug', (req, res) => {
  const slug = req.params.slug;
  const ip = req.headers['x-forwarded-for'] || req.socket.remoteAddress;
  const timestamp = new Date().toISOString();

  const logEntry = {
    slug,
    ip,
    userAgent: req.headers['user-agent'] || 'unknown',
    timestamp,
    referer: req.headers['referer'] || 'direct'
  };

  let data = JSON.parse(fs.readFileSync(LOG_FILE, 'utf8'));
  data.targets.push(logEntry);
  data.total_captures = data.targets.length;
  fs.writeFileSync(LOG_FILE, JSON.stringify(data, null, 2));

  if (redirects[slug]) {
    res.redirect(302, redirects[slug]);
  } else {
    res.status(404).send('Not found');
  }
});

app.get('/view/logs', (req, res) => {
  const data = fs.readFileSync(LOG_FILE, 'utf8');
  res.type('application/json').send(data);
});

app.get('/view/stats', (req, res) => {
  let data = JSON.parse(fs.readFileSync(LOG_FILE, 'utf8'));
  const stats = {
    total_targets: data.total_captures,
    unique_ips: [...new Set(data.targets.map(t => t.ip))].length,
    created: data.created,
    last_activity: data.targets[data.targets.length - 1]?.timestamp || 'none'
  };
  res.json(stats);
});

initializeLogs();
const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
  console.log(`VAINBIO GOLEM LIVE on port ${PORT}`);
  console.log(`Logs: http://localhost:${PORT}/view/logs`);
  console.log(`Stats: http://localhost:${PORT}/view/stats`);
});
